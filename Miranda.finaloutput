def main():

    while True:
        print("\n================================")
        print("       PYTHON TUTORIAL")
        print("================================")

        print("1. Introduction to Programming")
        print("2. Basic Syntax")
        print("3. Arithmetic Operators")
        print("4. Exit")

        choice = input("\nChoose lesson: ")

        if choice == "1":
            introduction()

        elif choice == "2":
            basic_syntax()

        elif choice == "3":
            arithmetic_operators()

        elif choice == "4":
            question_and_answer()

        elif choice == "5":
            problem_solving()

        elif choice == "6":
            print("\nThank you for using Python Tutorial!")
            print("Keep learning and keep practicing!")
            break

        else:
            print("\nInvalid choice! Please select 1-6.")


# RUN THE PROGRAM
main()
